{
  "$defs": {
    "Fonte": {
      "additionalProperties": false,
      "properties": {
        "titulo": {
          "title": "Titulo",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "revid": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revid"
        },
        "consulta": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Consulta"
        }
      },
      "required": [
        "titulo",
        "url"
      ],
      "title": "Fonte",
      "type": "object"
    },
    "Partido": {
      "additionalProperties": false,
      "properties": {
        "nome": {
          "minLength": 1,
          "title": "Nome",
          "type": "string"
        },
        "artigo": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Artigo"
        },
        "sigla": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Sigla"
        },
        "numero": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Numero"
        },
        "ativo": {
          "title": "Ativo",
          "type": "boolean"
        },
        "periodo": {
          "minLength": 1,
          "title": "Periodo",
          "type": "string"
        },
        "ano_fundacao": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ano Fundacao"
        },
        "data_criacao": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Data Criacao"
        },
        "data_registro": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Data Registro"
        },
        "ano_extincao": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ano Extincao"
        },
        "situacao": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Situacao"
        }
      },
      "required": [
        "nome",
        "artigo",
        "sigla",
        "numero",
        "ativo",
        "periodo",
        "ano_fundacao",
        "data_criacao",
        "data_registro",
        "ano_extincao",
        "situacao"
      ],
      "title": "Partido",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "dataset": {
      "title": "Dataset",
      "type": "string"
    },
    "descricao": {
      "title": "Descricao",
      "type": "string"
    },
    "licenca": {
      "default": "CC BY-SA 4.0 (conteúdo derivado da Wikipedia)",
      "title": "Licenca",
      "type": "string"
    },
    "gerado_em": {
      "format": "date-time",
      "title": "Gerado Em",
      "type": "string"
    },
    "fontes": {
      "items": {
        "$ref": "#/$defs/Fonte"
      },
      "title": "Fontes",
      "type": "array"
    },
    "dados": {
      "items": {
        "$ref": "#/$defs/Partido"
      },
      "minItems": 1,
      "title": "Dados",
      "type": "array"
    }
  },
  "required": [
    "dataset",
    "descricao",
    "gerado_em",
    "fontes",
    "dados"
  ],
  "title": "ArquivoPartido",
  "type": "object"
}
