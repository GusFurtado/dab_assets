{
  "$defs": {
    "Fonte": {
      "additionalProperties": false,
      "properties": {
        "titulo": {
          "title": "Titulo",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "revid": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revid"
        },
        "consulta": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Consulta"
        }
      },
      "required": [
        "titulo",
        "url"
      ],
      "title": "Fonte",
      "type": "object"
    },
    "Municipio": {
      "additionalProperties": false,
      "properties": {
        "codigo_ibge": {
          "maximum": 5399999,
          "minimum": 1100000,
          "title": "Codigo Ibge",
          "type": "integer"
        },
        "nome": {
          "minLength": 1,
          "title": "Nome",
          "type": "string"
        },
        "uf": {
          "enum": [
            "AC",
            "AL",
            "AP",
            "AM",
            "BA",
            "CE",
            "DF",
            "ES",
            "GO",
            "MA",
            "MT",
            "MS",
            "MG",
            "PA",
            "PB",
            "PR",
            "PE",
            "PI",
            "RJ",
            "RN",
            "RS",
            "RO",
            "RR",
            "SC",
            "SP",
            "SE",
            "TO"
          ],
          "title": "Uf",
          "type": "string"
        },
        "regiao": {
          "enum": [
            "Norte",
            "Nordeste",
            "Sudeste",
            "Sul",
            "Centro-Oeste"
          ],
          "title": "Regiao",
          "type": "string"
        },
        "wikidata": {
          "minLength": 1,
          "title": "Wikidata",
          "type": "string"
        },
        "artigo": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Artigo"
        },
        "gentilicos": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Gentilicos",
          "type": "array"
        },
        "fundacao": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Fundacao"
        },
        "ano_fundacao": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ano Fundacao"
        },
        "aniversario_dia": {
          "anyOf": [
            {
              "maximum": 31,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Aniversario Dia"
        },
        "aniversario_mes": {
          "anyOf": [
            {
              "maximum": 12,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Aniversario Mes"
        },
        "lema": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Lema"
        }
      },
      "required": [
        "codigo_ibge",
        "nome",
        "uf",
        "regiao",
        "wikidata",
        "artigo",
        "gentilicos",
        "fundacao",
        "ano_fundacao",
        "aniversario_dia",
        "aniversario_mes",
        "lema"
      ],
      "title": "Municipio",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "dataset": {
      "title": "Dataset",
      "type": "string"
    },
    "descricao": {
      "title": "Descricao",
      "type": "string"
    },
    "licenca": {
      "default": "CC BY-SA 4.0 (conteúdo derivado da Wikipedia)",
      "title": "Licenca",
      "type": "string"
    },
    "gerado_em": {
      "format": "date-time",
      "title": "Gerado Em",
      "type": "string"
    },
    "fontes": {
      "items": {
        "$ref": "#/$defs/Fonte"
      },
      "title": "Fontes",
      "type": "array"
    },
    "dados": {
      "items": {
        "$ref": "#/$defs/Municipio"
      },
      "minItems": 1,
      "title": "Dados",
      "type": "array"
    }
  },
  "required": [
    "dataset",
    "descricao",
    "gerado_em",
    "fontes",
    "dados"
  ],
  "title": "ArquivoMunicipio",
  "type": "object"
}
