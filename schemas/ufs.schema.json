{
  "$defs": {
    "Fonte": {
      "additionalProperties": false,
      "properties": {
        "titulo": {
          "title": "Titulo",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "revid": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revid"
        },
        "consulta": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Consulta"
        }
      },
      "required": [
        "titulo",
        "url"
      ],
      "title": "Fonte",
      "type": "object"
    },
    "UF": {
      "additionalProperties": false,
      "properties": {
        "sigla": {
          "enum": [
            "AC",
            "AL",
            "AP",
            "AM",
            "BA",
            "CE",
            "DF",
            "ES",
            "GO",
            "MA",
            "MT",
            "MS",
            "MG",
            "PA",
            "PB",
            "PR",
            "PE",
            "PI",
            "RJ",
            "RN",
            "RS",
            "RO",
            "RR",
            "SC",
            "SP",
            "SE",
            "TO"
          ],
          "title": "Sigla",
          "type": "string"
        },
        "codigo_ibge": {
          "title": "Codigo Ibge",
          "type": "integer"
        },
        "nome": {
          "minLength": 1,
          "title": "Nome",
          "type": "string"
        },
        "regiao": {
          "enum": [
            "Norte",
            "Nordeste",
            "Sudeste",
            "Sul",
            "Centro-Oeste"
          ],
          "title": "Regiao",
          "type": "string"
        },
        "wikidata": {
          "minLength": 1,
          "title": "Wikidata",
          "type": "string"
        },
        "artigo": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Artigo"
        },
        "capital": {
          "minLength": 1,
          "title": "Capital",
          "type": "string"
        },
        "area_km2": {
          "title": "Area Km2",
          "type": "number"
        },
        "latitude": {
          "title": "Latitude",
          "type": "number"
        },
        "longitude": {
          "title": "Longitude",
          "type": "number"
        },
        "gentilicos": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Gentilicos",
          "type": "array"
        },
        "lema": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Lema"
        },
        "bandeira": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Bandeira"
        },
        "brasao": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Brasao"
        }
      },
      "required": [
        "sigla",
        "codigo_ibge",
        "nome",
        "regiao",
        "wikidata",
        "artigo",
        "capital",
        "area_km2",
        "latitude",
        "longitude",
        "gentilicos",
        "lema",
        "bandeira",
        "brasao"
      ],
      "title": "UF",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "dataset": {
      "title": "Dataset",
      "type": "string"
    },
    "descricao": {
      "title": "Descricao",
      "type": "string"
    },
    "licenca": {
      "default": "CC BY-SA 4.0 (conteúdo derivado da Wikipedia)",
      "title": "Licenca",
      "type": "string"
    },
    "gerado_em": {
      "format": "date-time",
      "title": "Gerado Em",
      "type": "string"
    },
    "fontes": {
      "items": {
        "$ref": "#/$defs/Fonte"
      },
      "title": "Fontes",
      "type": "array"
    },
    "dados": {
      "items": {
        "$ref": "#/$defs/UF"
      },
      "minItems": 1,
      "title": "Dados",
      "type": "array"
    }
  },
  "required": [
    "dataset",
    "descricao",
    "gerado_em",
    "fontes",
    "dados"
  ],
  "title": "ArquivoUF",
  "type": "object"
}
